generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tag {
  tag_id  String @id @default(uuid())
  title String
  localTitle String
  Vacancy Vacancy[]
}

model Vacancy {
  vacancy_id String @id @default(uuid())
  title String
  company_id String
  company  CompanyProfile  @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  salaryFrom String?
  salaryTo String?
  description String
  tags  Tag[]
  lan String?
  lng String?
  imgUrl  String?
}
model CompanyProfile {
    company_id String @id @default(uuid())
    title String @unique
    imgUrl String? 
    pdfUrl String?
    description String
    phone String? @unique
    email String? @unique
    website String? @unique
    vacancies Vacancy[]
    user_id String @unique
    user Users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Users {
  user_id       String    @id @default(uuid())
  email         String    @unique
  password_hash String
  role          Roles
  passwordResetTokens PasswordResetTokens[]
  loginAttempts LoginAttempts[]
  accounts      Account[]
  sessions      Session[]
  CompanyProfile CompanyProfile?
}

model LoginAttempts {
  attempt_id    String   @id @default(uuid())
  ip_address    String
  attempt_time  DateTime @default(now())
  is_successful Boolean
  user_id       String
  user          Users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  
  @@index([user_id])
}

model PasswordResetTokens {
  token_id      String   @id @default(uuid())
  token         String   @unique
  expiration_date DateTime
  user_id       String
  user          Users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  
  @@index([user_id])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
 
  user Users @relation(fields: [userId], references: [user_id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         Users    @relation(fields: [userId], references: [user_id], onDelete: Cascade)
 
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
 
  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Roles {
  ADMIN
  USER
  GUEST
  COMPANY
}